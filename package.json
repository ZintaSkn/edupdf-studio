{
  "name": "edupdf-studio",
  "productName": "EduPDF Studio",
  "version": "1.3.0",
  "description": "Éditeur PDF hors-ligne pour l'enseignement : créer, modifier, organiser, scanner, OCR, convertir.",
  "main": "src/main.js",
  "author": "EduPDF",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@signpdf/placeholder-pdf-lib": "^4.0.0",
    "@signpdf/signer-p12": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/ita": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "docx": "^8.5.0",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "heic-convert": "^2.1.0",
    "mammoth": "^1.13.0",
    "mupdf": "^1.28.1",
    "node-forge": "^1.4.3",
    "officecrypto-tool": "^0.0.19",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174",
    "pptxgenjs": "^4.0.1",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.edupdf.studio",
    "productName": "EduPDF Studio",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "disableAsarIntegrity": true,
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/canvas/**",
      "!node_modules/@tesseract.js-data/*/4.0.0/**",
      "!node_modules/mupdf/dist/*.br",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/lib/**",
      "!**/*.map",
      "!**/*.d.ts"
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**",
      "node_modules/mupdf/**"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Document PDF",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ksehibi",
        "repo": "edupdf-studio",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@45.2.3": true
  }
}
