{
  "name": "edupdf-studio",
  "productName": "SknEDUpdf-studio",
  "version": "1.8.0",
  "description": "SknEDUpdf-studio : éditeur PDF hors-ligne pour l'enseignement (créer, modifier, organiser, scanner, OCR, convertir, IA).",
  "main": "src/main.js",
  "author": "EduPDF",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "publish": "electron-builder --win --publish always",
    "notices": "node tools/notices.js",
    "licence": "node tools/licence.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@signpdf/placeholder-pdf-lib": "^4.0.0",
    "@signpdf/signer-p12": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/ita": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "docx": "^8.5.0",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "heic-convert": "^2.1.0",
    "mammoth": "^1.13.0",
    "mupdf": "^1.28.1",
    "node-forge": "^1.4.3",
    "officecrypto-tool": "^0.0.19",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pptxgenjs": "^4.0.1",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.edupdf.studio",
    "productName": "SknEDUpdf-studio",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "disableAsarIntegrity": true,
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "compression": "maximum",
    "files": [
      "src/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "LICENSE",
      "TRADEMARK.md",
      "!node_modules/canvas/**",
      "!node_modules/@tesseract.js-data/*/4.0.0/**",
      "!node_modules/mupdf/dist/*.br",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/lib/**",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!**/*.d.cts",
      "!node_modules/@anthropic-ai/sdk/src/**",
      "!node_modules/@anthropic-ai/sdk/**/*.mjs",
      "!**/{README,CHANGELOG,HISTORY,CONTRIBUTING}*",
      "!**/{test,tests,__tests__,example,examples}/**",
      "!node_modules/libheif-js/libheif/**",
      "!node_modules/libheif-js/libheif-wasm/{libheif.js,libheif.wasm,*.mjs}",
      "!node_modules/pdf-lib/{es,src,ts3.4}/**",
      "!node_modules/pdf-lib/dist/pdf-lib.{js,esm.js,esm.min.js}",
      "!node_modules/@pdf-lib/fontkit/dist/fontkit.{es,es.min,umd}.js",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/exceljs/dist/**",
      "!node_modules/pdfjs-dist/build/{pdf.mjs,pdf.worker.mjs,pdf.renderer.mjs,pdf.sandbox.mjs,pdf.sandbox.min.mjs}"
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**",
      "node_modules/mupdf/**"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Document PDF",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "SknEDUpdf-studio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ksehibi",
        "repo": "edupdf-studio",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@45.2.3": true
  },
  "overrides": {
    "uuid": "^11.1.1",
    "image-size": "^2.1.0"
  }
}
